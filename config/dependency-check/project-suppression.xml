    <!--
      jruby-openssl is shaded into jruby-stdlib for AsciidoctorJ, used at build-time to render docs.
      It is not part of the runtime application artifact. Dependency-Check often maps it to the OpenSSL
      CPE, producing irrelevant findings. Suppress this false-positive mapping and revisit on upgrades.
    -->
    <suppress until="2027-12-31">
        <notes><![CDATA[
        Build-time only via AsciidoctorJ (shaded); not shipped at runtime. Suppressing false-positive
        CPE matches to jruby and OpenSSL to keep the gate actionable.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/rubygems/jruby\-openssl@.*$</packageUrl>
        <cpe>cpe:/a:jruby:jruby</cpe>
        <cpe>cpe:/a:openssl:openssl</cpe>
    </suppress>
</suppressions>
